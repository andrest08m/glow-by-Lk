# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# --- Base de datos (Supabase Postgres) ---
# Connection Pooling (puerto 6543, pgbouncer) — la usa la app en runtime.
# En el dashboard de Supabase: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (puerto 5432) — la usa Prisma CLI para migrate/db push.
# Project Settings > Database > Connection string > Direct connection
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx-xx-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (imágenes de producto) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# Service role: solo se usa en el servidor (server actions) para subir imágenes. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
SUPABASE_STORAGE_BUCKET="product-images"

# --- Auth (NextAuth / Auth.js v5) ---
# Genera uno con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET="reemplaza-esto-con-un-secreto-generado"

# Seed del usuario admin inicial (prisma/seed.ts crea/actualiza este usuario)
ADMIN_EMAIL="admin@glowbylk.com"
ADMIN_PASSWORD="cambia-esta-clave"

# --- Sitio ---
# Usada en metadata/OG/sitemap. En prod: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
