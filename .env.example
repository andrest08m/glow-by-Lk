# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# Service role: solo se usa en el servidor (admin, RPC, storage). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="product-images"

# --- Sitio ---
# Usada en metadata/OG/sitemap. En prod: https://tu-dominio.workers.dev
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Solo para el seed (scripts/seed.ts): crea el admin en Supabase Auth ---
ADMIN_EMAIL="admin@glowbylk.com"
ADMIN_PASSWORD="cambia-esta-clave"
